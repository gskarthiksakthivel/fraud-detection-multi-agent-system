# ── Copy this to .env and fill in your values ──────────────────────────────
# cp .env.example .env

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── LangSmith (get from smith.langchain.com) ─────────────────────────────────
LANGCHAIN_API_KEY=ls-your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=fraud-agentic-ai

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=3600

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── MCP Servers ──────────────────────────────────────────────────────────────
BANKING_MCP_URL=http://localhost:8002
COMPLIANCE_MCP_URL=http://localhost:8003

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_MINUTES=60
RATE_LIMIT_PER_MINUTE=60

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
